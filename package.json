  "description": "A drop-in svelte-check replacement: up to 11× faster, zero dependencies.",
  "license": "MIT",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-typecheck.git"
  },
