{
  "name": "svelte-typecheck",
  "version": "0.1.7",
  "license": "MIT",
  "description": "A drop-in svelte-check replacement that checks with tsc, tsgo, tsrs or bun check. Up to 11x faster, zero dependencies.",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "svelte-typecheck": "dist/cli.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test ./tests",
    "test:changed": "bivium run --suite unit",
    "test:package": "bun scripts/test-package.ts",
    "bench": "ostia ci",
    "bench:baseline": "ostia baseline save",
    "typecheck": "bun check",
    "knip": "knip-bun",
    "fmt": "bun fmt",
    "lint": "bun fmt --check && bun lint --no-script --max-warnings 0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bivium": "^0.4.0",
    "bun-types": "1.4.4",
    "knip": "^6.43.0",
    "magic-string": "^1.4.5",
    "ostia": "^0.2.12",
    "sveast": "^0.9.6",
    "svelte": "^5.57.3",
    "svelte-check": "4.7.8",
    "svelte3": "npm:svelte@^3.59.2",
    "svelte4": "npm:svelte@^4.2.20",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-typecheck.git"
  },
  "homepage": "https://github.com/metonym/svelte-typecheck",
  "bugs": "https://github.com/metonym/svelte-typecheck/issues",
  "keywords": [
    "svelte",
    "typecheck",
    "typescript",
    "svelte-check",
    "tsgo",
    "tsrs",
    "bun",
    "ci"
  ]
}
