{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/{index,cli}.ts",
    "scripts/*.ts",
    "bench/*.bench.ts",
    "bench/check.ts",
    "eval/*.ts",
    "ostia.config.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "eval/**/*.ts"
  ],
  "ignore": ["tests/fixtures*/**"],
  "ignoreDependencies": [
    "@sveltejs/kit",
    "@typescript/native-preview",
    "magic-string",
    "svelte",
    "svelte-check",
    "svelte3",
    "svelte4",
    "tsrs",
    "vite"
  ]
}
