{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/{index,cli,compile-worker}.ts",
        "scripts/*.ts",
        "ostia.config.ts",
        "bivium.config.ts"
      ],
      "project": ["src/**/*.ts", "tests/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["bun-types"]
    },
    "bench": {
      "entry": ["*.bench.ts", "check.ts"],
      "project": ["*.ts"],
      "ignoreDependencies": [
        "@sveltejs/kit",
        "@typescript/native",
        "svelte",
        "tsrs",
        "vite"
      ]
    },
    "eval": {
      "entry": ["*.ts"],
      "project": ["*.ts"],
      "ignoreDependencies": ["@typescript/native", "svelte-check", "tsrs"]
    }
  },
  "ignoreWorkspaces": ["tests/projects/*"]
}
